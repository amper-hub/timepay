{
  "name": "timepay-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "postinstall": "node scripts/patch-mlkit-detector-close.cjs",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "npm run test:errors && npm run test:auth-storage && npm run test:camera-permission && npm run test:geofence && npm run test:attendance-event && npm run test:attendance-api && npm run test:attendance-diagnostics",
    "test:errors": "node --test tests/errorMessages.test.cjs",
    "test:auth-storage": "node --test tests/authStorage.test.cjs",
    "test:camera-permission": "node --test tests/cameraPermission.test.cjs",
    "test:geofence": "node --test tests/geofence.test.cjs",
    "test:attendance-event": "node --test tests/attendanceEvent.test.cjs",
    "test:attendance-api": "node --test tests/attendanceApi.test.cjs",
    "test:attendance-diagnostics": "node --test tests/attendanceDiagnostics.test.cjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-ml-kit/face-detection": "^2.0.1",
    "@react-navigation/bottom-tabs": "^7.18.14",
    "@react-navigation/native": "^7.3.14",
    "axios": "^1.20.0",
    "expo": "~54.0.37",
    "expo-camera": "~17.0.10",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-image-manipulator": "~14.0.8",
    "expo-location": "~19.0.8",
    "expo-network": "~8.0.8",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "shell-quote": "^1.11.0"
  },
  "private": true
