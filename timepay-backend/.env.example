APP_NAME=TimePay
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=UTC

LOG_CHANNEL=stderr
LOG_LEVEL=debug

# Local MySQL. On Railway map these DB_* names from the Railway MySQL service.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=timepay
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
# Optional absolute path for Laravel's private disk; set only after preserving existing face photos.
# Railway volume example: FILESYSTEM_PRIVATE_ROOT=/app/storage/app/private

TIMEPAY_ATTENDANCE_TIMEZONE=Asia/Manila

# Only set for the payroll foundation migration after employer verification.
# JSON object mapping employee user IDs to verified historical rate effective dates.
# Example: PAYROLL_LEGACY_RATE_EFFECTIVE_DATES={"123":"2024-01-01","456":"2025-07-15"}
# Never use the deployment date as a substitute for historical evidence.

# Keep Face++ credentials server-side. Never use EXPO_PUBLIC_* for these.
FACEPP_API_KEY=your-facepp-api-key
FACEPP_API_SECRET=your-facepp-api-secret
FACEPP_COMPARE_URL=https://api-us.faceplusplus.com/facepp/v3/compare
FACEPP_DETECT_URL=https://api-us.faceplusplus.com/facepp/v3/detect
FACEPP_CONFIDENCE_THRESHOLD=80
FACEPP_EYE_CONFIDENCE_THRESHOLD=70
FACEPP_AUDIT_RETURN_ATTRIBUTES=facequality,blur
FACEPP_AUDIT_MIN_FACEQUALITY=50

MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"
